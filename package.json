{
  "name": "local-resume-studio",
  "productName": "简历工坊",
  "version": "1.1.0",
  "private": true,
  "description": "可离线编辑、试排和导出 31 款模板的 Mac 简历编辑器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build-native.cjs && tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package.cjs",
    "test": "node --test tests/*.test.cjs",
    "acceptance": "node tests/acceptance.cjs",
    "test:editor": "node tests/editor-acceptance.cjs",
    "test:paper": "node tests/paper-acceptance.cjs",
    "test:import": "node tests/import-acceptance.cjs",
    "test:performance": "node tests/performance.cjs",
    "format:check": "prettier --check src electron scripts/*.cjs tests/*.cjs vite.config.ts",
    "test:release": "node scripts/accept-release.cjs",
    "test:templates": "node tests/template-acceptance.cjs && node tests/template-recovery.cjs && node tests/template-navigation.cjs",
    "test:template-pdf": "node tests/template-pdf.cjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.0",
    "@fontsource-variable/noto-serif-sc": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
